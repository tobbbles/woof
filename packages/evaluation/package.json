{
  "name": "@woof/evaluation",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Pure flag evaluation engine for Woof — no I/O, no Worker dependencies",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobbbles/woof.git",
    "directory": "packages/evaluation"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@woof/types": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  }
}
