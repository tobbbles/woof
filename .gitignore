.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*

# Build outputs
dist/
build/
coverage/
*.tsbuildinfo

# Local dev secrets
.dev.vars

# Wrangler config (contains real KV IDs, domains, secrets)
# Use wrangler.toml.example as the tracked template.
packages/*/wrangler.toml

packages/**/.wrangler/

# Environment files
.env.local
.env*.local

# Editor/tool config
.claude/
